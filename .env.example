POSTGRES_DB=oncology
POSTGRES_USER=oncology
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql+psycopg://oncology:change-me-local-only@db:5432/oncology

GLOBAL_MATURITY_MODE=N2
N1_ASSISTIVE_SEARCH_ENABLED=true
OPERATOR_MAX_ACTIVE_CONVERSATIONS=4
ANONYMOUS_TOKEN_PEPPER=replace-with-a-long-random-local-secret
OPERATOR_AUTH_SECRET=replace-with-a-different-long-random-local-secret
OPERATOR_AUTH_TTL_MINUTES=480

OPENAI_API_KEY=
AI_PROVIDER=openai
AI_GENERATION_MODEL=gpt-5-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSION=1536

API_ROOT_PATH=/api/v1
LOG_LEVEL=INFO
APP_TIMEZONE=America/Sao_Paulo
