POSTGRES_DB=oncology
POSTGRES_USER=oncology
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql+psycopg://oncology:change-me-local-only@db:5432/oncology

GLOBAL_MATURITY_MODE=N2
N1_ASSISTIVE_SEARCH_ENABLED=true
OPERATOR_MAX_ACTIVE_CONVERSATIONS=4
ANONYMOUS_TOKEN_PEPPER=replace-with-a-long-random-local-secret
OPERATOR_AUTH_SECRET=replace-with-a-different-long-random-local-secret
OPERATOR_AUTH_TTL_MINUTES=480

# V2 anonymous-token validation rate limiting (plan.md §13.1)
ANONYMOUS_TOKEN_RATE_LIMIT_MAX_FAILURES=30
ANONYMOUS_TOKEN_RATE_LIMIT_WINDOW_SECONDS=60
ANONYMOUS_TOKEN_RATE_LIMIT_BASE_LOCKOUT_SECONDS=60
ANONYMOUS_TOKEN_RATE_LIMIT_MAX_LOCKOUT_SECONDS=900

# Operator login credentials are intentionally not runtime environment settings.
# Create/update synthetic operators only with customer_care.auth.seed_operator.

OPENAI_API_KEY=
AI_PROVIDER=openai
AI_GENERATION_MODEL=gpt-5-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSION=1536

# Langfuse Cloud: LF-1 uses an isolated probe; application hooks await LF-2.
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
# LANGFUSE_HOST is a legacy alias; if both URLs are set, they must agree.

API_ROOT_PATH=/api/v1
LOG_LEVEL=INFO
APP_TIMEZONE=America/Sao_Paulo
